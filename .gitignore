# Gradle
.gradle/
build/
out/
classes/

# Gradle Wrapper (tracked on purpose)
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
.idea_modules/

# Eclipse
.classpath
.eclipse/
.project
.settings/
bin/

# VSCode
.vscode/
*.code-workspace

# Minecraft mod development
run/
run-gametest/
runs/
logs/
*.log
crash-reports/

# NeoForge — ignore datagen cache/scratch but keep the resources output tracked
src/generated/*
!src/generated/resources/
src/generated/resources/.cache/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Java
*.class
hs_err_pid*
replay_pid*

# Misc
*.bak
*.tmp
*.swp
*~
local.properties

# Markdown: ignored by default. Tracked: root README, LICENSE and CHANGELOG,
# release changelogs, docs and wiki pages, and markdown inside mod sources
*.md
!/README.md
!/LICENSE.md
!/CHANGELOG.md
!/metadata/changelogs/**/*.md
!/docs/**/*.md
!/wiki/**/*.md
!**/src/**/*.md

# Batch files: only the Gradle wrapper
*.bat
!gradlew.bat

/tools/
