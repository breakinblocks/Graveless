{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_authors}"
    ],
    "contact": {
        "issues": "https://github.com/breakinblocks/Graveless/issues",
        "sources": "https://github.com/breakinblocks/Graveless"
    },
    "license": "${mod_license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.breakinblocks.graveless.GravelessFabric"
        ],
        "client": [
            "com.breakinblocks.graveless.GravelessFabricClient"
        ]
    },
    "accessWidener": "${mod_id}.accesswidener",
    "mixins": [
        "${mod_id}.fabric.mixins.json",
        {
            "config": "${mod_id}.fabric.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "forgeconfigapiport": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    }
}
